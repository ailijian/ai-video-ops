<service>
  <id>ai-video-ops-internal-console</id>
  <name>AI Video Ops Internal Console</name>
  <description>Single-process Local Production Node console and task workers.</description>
  <executable>E:\AI-Video-Ops\internal-console\.venv\Scripts\python.exe</executable>
  <arguments>-m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips &quot;127.0.0.1,::1&quot;</arguments>
  <workingdirectory>E:\AI-Video-Ops\internal-console</workingdirectory>
  <env name="AIVO_ENV_FILE" value="E:\AI-Video-Ops-Config\local-node.production.env" />
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>E:\AI-Video-Ops-Logs\internal-console</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
    <zipDateFormat>yyyyMMdd</zipDateFormat>
  </log>
</service>
