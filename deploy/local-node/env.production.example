# Copy outside the repository, restrict the file ACL to the service account,
# and point WinSW at it with AIVO_ENV_FILE. Never put real secrets here.
AIVO_CONSOLE_DB=E:\AI-Video-Ops\internal-console\var\console.sqlite3
AIVO_PIPELINE_PYTHON=E:\AI-Video-Ops\ops-pipeline\.venv\Scripts\python.exe
AIVO_SECURE_COOKIES=1
AIVO_SESSION_HOURS=12
AIVO_STATUS_TIMEOUT_SECONDS=30
AIVO_CASE_ANALYSIS_WORKER=1
AIVO_CUSTOMER_ANALYSIS_WORKER=1
AIVO_SPEAKER_ANALYSIS_WORKER=1
AIVO_BACKGROUND_WORKER=1
AIVO_TASK_QUEUE_MAX=20
AIVO_GPU_PENDING_PER_USER_MAX=3
AIVO_STORAGE_MAINTENANCE_INTERVAL_SECONDS=3600
AIVO_TASK_LEASE_SECONDS=120
AIVO_TASK_HEARTBEAT_SECONDS=10
AIVO_SESSION_LAST_SEEN_INTERVAL_SECONDS=300

# Optional UI convenience only. Leave unset for fresh Production; it never
# changes Customer, Persona, or Ledger Authority.
# AIVO_DEFAULT_BUSINESS_ID=customer_example

# Accepts a faster-whisper model name or an existing absolute local model directory.
AIVO_WHISPER_MODEL=E:\ai-model-cache\faster-whisper-large-v3

# Apply these to the single Ollama production process, not as global user env.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Store DEEPSEEK_API_KEY only in the protected production env file or the
# existing protected pipeline .env. Do not add it to this template.
